# ── SSRF guard: MCP proxy (api/mcp), provider URLs (api/chat), model lists (api/models) ──
# Private/LAN/localhost and http:// targets (local MCP servers, Ollama, LM Studio,
# other OpenAI-compatible servers) are allowed automatically under `npm run dev`.
# Production builds (Vercel, Docker, `next start`) block them. Set to "1" ONLY if
# a self-hosted instance must reach your own LAN; never on a public deployment.
# ALLOW_PRIVATE_MCP=1 is a deprecated alias for the same switch.
ALLOW_PRIVATE_NETWORK=

# ── Rate Limiting (optional) ────────────────────────────────
# Local forks may leave both credentials empty. Public deployments should set
# RATE_LIMIT_REQUIRED=1 so missing credentials reject requests with HTTP 503.
# Create a free database at https://upstash.com -> Redis -> REST API details.
# Use the base HTTPS REST URL, without /pipeline or /multi-exec suffixes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Max requests per 60-second window starting at the first request.
# Without a trusted IP header, each scope has one shared bucket for all users.
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_MCP_PER_MINUTE=60
RATE_LIMIT_MODELS_PER_MINUTE=30
RATE_LIMIT_REQUIRED=0
# Fail closed when configured Redis is unavailable. "1" explicitly weakens
# protection; it does not bypass missing credentials or invalid configuration.
RATE_LIMIT_FAIL_OPEN=0
# Select one header ONLY when the trusted edge overwrites it with one valid IP
# and clients cannot reach the origin directly. XFF chains are not accepted.
# Example behind such a proxy: RATE_LIMIT_IP_HEADER=x-real-ip
RATE_LIMIT_IP_HEADER=
# Absolute Redis deadline, including response body; range 1..10000 milliseconds.
RATE_LIMIT_TIMEOUT_MS=2000
